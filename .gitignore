#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local secrets: commit only the empty template
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
**/key.properties
**/local.properties
**/service-account*.json

# Generated platform files and local editor state
.flutter-plugins
**/ephemeral/
**/.plugin_symlinks/
**/.symlinks/
**/.gradle/
**/Pods/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json

# SQLite runtime journals (keep the bundled database itself)
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db-wal
*.db-shm
