{
  "version": 8,
  "name": "Camino offline services",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "minzoom": 0,
      "maxzoom": 14,
      "attribution": "\u00a9 OpenMapTiles \u00a9 OpenStreetMap contributors"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#f5f1e8"
      }
    },
    {
      "id": "landcover",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "paint": {
        "fill-color": "#dbe5c7",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "landuse",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "paint": {
        "fill-color": "#e6e3d3"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#cfe4bd"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a4d2e4"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#8abacf",
        "line-width": 1
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "paint": {
        "line-color": "#aca3b1",
        "line-width": 1,
        "line-dasharray": [
          4,
          3
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "paint": {
        "fill-color": "#cbbfb3",
        "fill-outline-color": "#b8aaa0"
      },
      "minzoom": 13
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#d0bda7",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          1,
          14,
          4,
          18,
          12
        ]
      },
      "filter": [
        "!=",
        [
          "get",
          "class"
        ],
        "path"
      ]
    },
    {
      "id": "roads",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#fffdf5",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.6,
          14,
          2.5,
          18,
          9
        ]
      },
      "filter": [
        "!=",
        [
          "get",
          "class"
        ],
        "path"
      ]
    },
    {
      "id": "paths",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "paint": {
        "line-color": "#b38155",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.7,
          14,
          1.8,
          18,
          3
        ],
        "line-dasharray": [
          3,
          2
        ]
      },
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "path"
      ]
    },
    {
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": [
        "==",
        [
          "get",
          "subclass"
        ],
        "restaurant"
      ],
      "id": "poi-restaurant",
      "type": "symbol",
      "minzoom": 12,
      "layout": {
        "icon-image": "restaurant",
        "icon-size": 1,
        "icon-allow-overlap": false,
        "icon-padding": 2
      }
    },
    {
      "source": "openmaptiles",
      "source-layer": "poi",
      "filter": [
        "==",
        [
          "get",
          "subclass"
        ],
        "restaurant"
